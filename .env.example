# ============================================================
#  RentaGift — sozlamalar. Bu faylni .env deb nusxalang.
#  Qiymatlarda bo'sh joy bo'lsa, qo'shtirnoqqa oling: "ALI VALIYEV"
#  Eslatma: APP_NAME, SUPPORT/CHANNEL, OFFER_URL, DEFAULT_LANG, to'lov, balans, avto-tasdiq, MAX_TX_*, AUTO_RENT va
#  BACKUP_* ni admin panel → «Bot sozlamalari» dan ham o'zgartirsa bo'ladi (bu yerdagi qiymat standart bo'lib qoladi).
# ============================================================

# --- Telegram ---------------------------------------------------------------
BOT_TOKEN=                         # @BotFather bergan token
ADMIN_IDS=123456789                # admin Telegram ID lari, vergul bilan: 111,222
OPERATOR_IDS=                      # operatorlar (ixtiyoriy): panelda faqat buyurtma/balans/Stars/mijozlar bilan ishlaydi, foyda va sozlamalarni ko'rmaydi
MIN_TON_BALANCE=5                  # admin hamyonida shundan kam TON qolsa adminlarga ogohlantirish (0 = o'chiq)
WEBAPP_URL=https://rent.example.uz # shu server ochiladigan HTTPS manzil (Railway'da bo'sh qoldirsa ham bo'ladi)
APP_NAME=RentaGift
DEFAULT_LANG=uz                    # uz | ru | en
SUPPORT_USERNAME=                  # @ siz, masalan giftrent_support
CHANNEL_USERNAME=
CHANNEL_POPUP=true                 # Mini App ochilganda kanalga taklif oynasi
OFFER_URL=                         # ommaviy oferta sahifasi
TIMEZONE=Asia/Tashkent

# --- Marketapp ----------------------------------------------------------------
# Token marketapp.org da ADMIN HAMYONI bilan yaratiladi.
# Ijara to'lovlari faqat shu hamyondan yuborilishi shart.
MARKETAPP_API_TOKEN=
# Bepul tarif yetadi (/rent va /collections bepul). Pullik tarif bo'lsa true qiling:
# shunda gift holati qo'shimcha ravishda pullik /v1/nfts/{address}/ orqali tekshiriladi.
MARKETAPP_PAID_PLAN=false

# --- TON hamyon -------------------------------------------------------------
ADMIN_WALLET_ADDRESS=              # token yaratilgan hamyon manzili (UQ... yoki EQ...)
# tonconnect = admin har bir to'lovni Tonkeeper/Telegram Wallet'da o'zi tasdiqlaydi (tavsiya)
# hot        = server o'zi imzolaydi (V4R2 hamyon, 24 so'z kerak). Faqat kichik balans saqlang!
WALLET_MODE=tonconnect
HOT_WALLET_MNEMONIC=
AUTO_RENT=false                    # hot rejimda: to'lov tasdiqlangach avtomatik ijaraga olish
TONCENTER_API_KEY=                 # hot rejim uchun tavsiya (toncenter.com)
MAX_TX_OVERPAY_PERCENT=5           # Marketapp narxi kotirovkadan shuncha % dan oshsa imzolanmaydi
MAX_TX_FEE_TON=0.5

# --- To'lov (karta orqali) ---------------------------------------------------
# Har buyurtmaga +1..99 so'm qo'shiladi (masalan 3 090 → 3 093) — CardXabar xabaridan qaysi buyurtma
# to'langanini aniq bilish uchun. 0 = o'chiq.
UNIQUE_AMOUNT_MAX=99
CARD_NUMBER="8600 0000 0000 0000"
CARD_HOLDER="ISM FAMILIYA"
CARD_BANK=
PAYMENT_WINDOW_MINUTES=30
MAX_OPEN_ORDERS_PER_USER=3

# --- Narx (admin paneldan ham o'zgartiriladi) -------------------------------
# Mijoz narxi = Ijara + Xizmat haqi
#   Ijara       = Marketapp narxi × (1 + komissiya%) × kurs × kun   (masalan 450 so'm × 3 kun = 1 350)
#   Xizmat haqi = har buyurtmaga qat'iy summa — sizning foydangiz      (masalan 1 800 so'm)
MARKETAPP_FEE_PERCENT=0            # Marketapp komissiyasi; birinchi ijaradan keyin admin panel aniq qiymatni ko'rsatadi
SERVICE_FEE_UZS=1800               # xizmat haqi, so'm (har buyurtma uchun) — SERVICE_FEE_TON 0 bo'lsa
SERVICE_FEE_TON=0                  # xizmat haqi TON'da (masalan 0.01) — jonli kurs bo'yicha so'mga aylanadi
MIN_RENT_DAYS=1                    # do'kon minimumi; har bir gift Marketapp'dagi o'z minimumi (1 yoki 3 kun) bilan
MARKUP_PERCENT=0                   # ijaraning o'ziga ustama, % (odatda 0)
PROFIT_FIXED_UZS=0                 # (eskirgan, ishlatilmaydi — foyda: MARKUP_PERCENT + xizmat haqi)
RATE_MODE=auto                     # auto (CoinGecko × CBU) | manual
MANUAL_RATE_UZS_PER_TON=0          # manual rejimda 1 TON necha so'm
UZS_ROUND_TO=10                    # kunlik narx shu songa yuqoriga yaxlitlanadi

# --- Server ----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/giftrent.db
# PostgreSQL: DATABASE_URL=postgresql+asyncpg://giftrent:parol@db:5432/giftrent
# Railway: DATABASE_URL=${{Postgres.DATABASE_URL}}  (postgres://… avtomatik to'g'rilanadi)
HOST=0.0.0.0
PORT=8080
USE_RENT_EVENTS=true               # Marketapp /rent/events orqali tezkor kuzatuv (my-rented zaxira sifatida qoladi)
DEMO_MODE=false                    # true = soxta katalog, tokensiz UI sinash uchun
DEV_USER_ID=0                      # FAQAT lokal sinov: initData'siz shu ID bilan kirish

# --- Alohida admin panel (Vercel) -----------------------------------------
# admin-panel/ papkasi Vercel'ga alohida yuklanadi. Bu yerga uning manzilini yozing:
# bot tugmalari va /panel buyrug'i shu saytni ochadi, CORS ham avtomatik ruxsat beradi.
ADMIN_PANEL_URL=                   # masalan https://giftrent-admin.vercel.app
ADMIN_PANEL_ORIGINS=               # qo'shimcha domenlar, vergul bilan (odatda bo'sh)
ADMIN_PANEL_PASSWORD=              # ixtiyoriy: Telegram ID + parol bilan kirish (kamida 8 belgi)
ADMIN_SECRET=                      # sessiya imzosi; bo'sh = BOT_TOKEN'dan hosil qilinadi
ADMIN_SESSION_HOURS=72

# --- Zaxira nusxa (backup) -------------------------------------------------
BACKUP_INTERVAL_HOURS=24           # har necha soatda zaxira olinadi (0 = o'chiq)
BACKUP_KEEP=14                     # serverda nechta oxirgi zaxira saqlanadi
BACKUP_DIR=data/backups
BACKUP_SEND_TO_ADMINS=true         # har bir zaxira adminlarga Telegram'da fayl qilib yuboriladi

# --- Avtomatik to'lov tekshiruvi (CardXabar, Uzcard) ----------------------------
# Alohida Telegram akkauntga @CardXabarBot ulanadi. Shu akkaunt sessiyasi bilan bot kirim xabarlarini
# o'qiydi va summasi mos buyurtmani o'zi tasdiqlaydi. Sessiya: python tools/make_session.py
AUTO_CONFIRM_PAYMENTS=true
USERBOT_API_ID=                    # my.telegram.org → API development tools (alohida akkaunt bilan)
USERBOT_API_HASH=
USERBOT_SESSION=                   # MAXFIY! akkauntga to'liq kirish — hech kimga bermang
CARD_NOTIFY_BOTS=CardXabarBot
CARD_LAST4=                        # faqat shu karta (masalan 4625). Bo'sh = hamma kartalar
CARD_NOTIFY_LATE_MINUTES=120       # vaqti o'tib bekor bo'lgan buyurtmaga kech kelgan pul — adminga so'rov

# --- Balans, Stars/Premium, referal -------------------------------------------
TOPUP_MIN_UZS=5000
TOPUP_MAX_UZS=5000000
STARS_MARKUP_PERCENT=10            # Stars narxiga ustama (foydangiz)
PREMIUM_MARKUP_PERCENT=10          # Premium narxiga ustama
REFERRAL_PERCENT=1                 # taklif qilingan do'st to'lovining necha % taklif qilganga
PURCHASE_CONFIRM_MINUTES=10
